g."},{"id":"auto","name":"Auto","description":"Approve edits and safe commands; ask before irreversible actions."},{"id":"plan","name":"Plan","description":"Plan carefully before executing a task."}]},"configOptions":[{"id":"model","name":"Model","category":"model","type":"select","currentValue":"gemini-4-neon","options":[{"value":"gemini-4-neon","name":"Gemini 4 Neon"},{"value":"gemini-4-argon","name":"Gemini 4 Argon"},{"value":"gemini-4-hydrogen","name":"Gemini 4 Hydrogen"},{"value":"gemini-pro-orchestrator-neon","name":"Orchestrator (Neon)"},{"value":"gemini-pro-orchestrator-g1-pro","name":"Orchestrator (Argon)"},{"value":"gemini-3.8-flash","name":"Gemini 3.8 Flash"},{"value":"claude-opus-5-5","name":"Claude Opus 5.5"},{"value":"claude-sonnet-5-5","name":"Claude Sonnet 5.5"},{"value":"gpt-oss-120b-medium","name":"GPT-OSS 120B (Medium)"}]},{"id":"thought_level","name":"Thinking Level","category":"thought_level","type":"select","currentValue":"high","options":[{"value":"low","name":"Low"},{"value":"medium","name":"Medium"},{"value":"high","name":"High"},{"value":"xhigh","name":"Extra"}]},{"id":"mode","name":"Mode","category":"mode","type":"select","currentValue":"default","options":[{"value":"default","name":"Default","description":"Ask before edits and commands, per your permission settings."},{"value":"accept-edits","name":"Accept edits","description":"Approve file edits in the workspace without asking."},{"value":"auto","name":"Auto","description":"Approve edits and safe commands; ask before irreversible actions."},{"value":"plan","name":"Plan","description":"Plan carefully before executing a task."}]}],"_meta":{"antigravity":{"tier":{"name":"Plan","id":"plan-tier","upgradeUri":"https://example.com/upgrade"}}}},"id":2}
