< {"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"00000000-0000-4000-8000-0000000000c1","update":{"sessionUpdate":"tool_call_update","toolCallId":"replay-0-6","status":"completed","rawOutput":{"exitCode":0,"stdout":"80015 79765 80015 /bin/zsh -c IFS= builtin read -r -d '' __cursor_command <&5 2>/dev/null || { builtin printf '%s\\n' 'The command did not run: a shell startup file ($BASH_ENV or .zshenv) closed or replaced file descriptor 5, which carries the command. Run it again; this shell now passes commands as arguments.' >&2; builtin exit 126; }; exec 5<&-; builtin set -- \"$__cursor_command\"; builtin unset __cursor_command; builtin export PATH=\"/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}\"; snap=$(command cat <&3); builtin unsetopt aliases 2>/dev/null; builtin unalias -m '*' 2>/dev/null || true; #!/usr/bin/env zsh\\012\\012# Usage:\\012#   source dump_zsh_state.zsh\\012#   dump_zsh_state\\012# Or execute directly (captures a subshell's state):\\012#   ./dump_zsh_state.zsh\\012\\012# Define a function so sourcing won't alter caller state; emulate locally inside\\012function dump_zsh_state() {\\012  emulate -L zsh -o errreturn -o pipefail\\012  set -u\\012\\012\\012  # Helper to log timing, only if DUMP_ZSH_STATE_TIMING is set\\012  if [[ -n \"${DUMP_ZSH_STATE_TIMING:-}\" ]]; then\\012    # Timing setup\\012    typeset start_time=${EPOCHREALTIME}\\012    typeset step_start=${EPOCHREALTIME}\\012    _log_timing() {\\012      typeset step_name=\"$1\"\\012      typeset now=${EPOCHREALTIME}\\012      typeset step_duration=$((now - step_start))\\012      typeset total_duration=$((now - start_time))\\012      builtin printf \"[TIMING] %-20s: %6.3fs (total: %6.3fs)\\012\" \"$step_name\" \"$step_duration\" \"$total_duration\" >&2\\012      step_start=$now\\012    }\\012  else\\012    _log_timing() { :; }\\012  fi\\012\\012  # Ensure parameter arrays are available\\012  builtin zmodload -F zsh/parameter p:parameters p:options p:functions p:aliases p:galiases p:saliases 2>/dev/null || true\\012  _log_timing \"zmodload\"\\012\\012  # Helper to print a line to stdout\\012  _emit() {\\012    builtin print -r -- \"$1\"\\012  }\\012\\012  # Helper to safely encode and emit unsafe values, then the line that replays them (one eval by default)\\012  _emit_encoded() {\\012    local content=\"$1\"\\012    local var_name=\"$2\"\\012    if [[ -n \"$content\" ]]; then\\012      # Builtin printf, not a here-document: no argument length limit, and no temp file\\012      builtin printf 'cursor_snap_%s=$(builtin printf %%s '\"'\"'%s'\"'\"' | command base64 -d)\\012' \"$var_name\" \"$(command base64 <<<\"$content\" | command tr -d '\\012')\"\\012      if [[ -n \"${3:-}\" ]]; then\\012        builtin print -r -- \"$3\"\\012      else\\012        builtin printf 'builtin eval \"$cursor_snap_%s\"\\012' \"$var_name\"\\012      fi\\012    fi\\012  }\\012\\012  # Aliases replay after the functions, so a user function named alias would run in place of\\012  # each alias line. Only a line that starts an alias gets builtin: a quoted value can span\\012  # lines, and a continuation line can start with \"alias \". awk reads bytes under LC_ALL=C, so a\\012  # value that is not valid UTF-8 does not make it warn. Without awk the lines stay as they are.\\012  _builtin_alias_lines() {\\012    [[ -n \"$1\" ]] || return 0\\012    builtin printf '%s\\012' \"$1\" | LC_ALL=C command awk -v sq=\"'\" '\\012      !q && /^alias / { $0 = \"builtin \" $0 }\\012      {\\012        print\\012        for (i = 1; i <= length($0); i++) {\\012          c = substr($0, i, 1)\\012          if (q == 1) { if (c == sq) q = 0 }\\012          else if (q == 2) { if (c == \"\\\\\") i++; else if (c == sq) q = 0 }\\012          else if (c == \"\\\\\") i++\\012          else if (c == \"$\" && substr($0, i + 1, 1) == sq) { q = 2; i++ }\\012          else if (c == sq) q = 1\\012        }\\012      }' 2>/dev/null ||\\012      builtin printf '%s\\012' \"$1\"\\012  }\\012\\012  _log_timing \"init\"\\012\\012  local tool\\012  for tool in base64 tr; do\\012    if ! builtin whence -p \"$tool\" >/dev/null 2>&1; then\\012      builtin print -ru2 -- \"Shell state not saved: $tool is not on PATH\"\\012      return 0\\012    fi\\012  done\\012  if ! command base64 </dev/null >/dev/null 2>&1; then\\012    builtin print -ru2 -- \"Shell state not saved: the environment is too large to run commands\"\\012    return 0\\012  fi\\012\\012  # Emit start marker at the very beginning of the output\\012  _emit \"__CURSOR_ZSH_STATE_START__\"\\012\\012  # Header\\012  _emit \"$PWD\"\\012\\012  _emit \"# zsh state dump generated on $(command date +'%Y-%m-%d %H:%M:%S %z')\"\\012  _log_timing \"header\"\\012\\012  # Working directory\\012  _log_timing \"working_dir\"\\012\\012  # Drop ELECTRON_RUN_AS_NODE by exact name so one command exporting it can't\\012  # bake it into the snapshot that every later command re-evals (IDE-2911:\\012  # Cypress boots as plain Node until a new chat). Exact unset rather than the\\012  # line-based grep below, which would also eat vars whose name or multiline\\012  # value merely contains the token. The shell exits right after the dump.\\012  builtin unset ELECTRON_RUN_AS_NODE 2>/dev/null || true\\012\\012  # Environment variables (exported)\\012  # Filter out: proxy settings plus request/session-scoped vars that must not\\012  # leak across shell executions.\\012  # Under a non-UTF-8 locale zsh writes byte 0xa7 inside $'...' as M-', which\\012  # its own parser reads as the closing quote (zsh 5.9 Src/utils.c quotestring,\\012  # https://github.com/zsh-users/zsh/blob/zsh-5.9/Src/utils.c); the sed rewrites\\012  # that one escape to the § form so the restore eval can parse it. It runs\\012  # only on scalar $'...' lines: a plain-quoted value can hold the same four\\012  # characters literally, and there they must stay.\\012  local env_vars\\012  env_vars=$(builtin typeset -xp 2>/dev/null | command grep -viE '_proxy=|CURSOR_SANDBOX|SUDO_ASKPASS|CURSOR_ASKPASS|CURSOR_CONVERSATION_ID|CURSOR_REQUEST_ID|CURSOR_AGENT_STORE' | command sed \"/^export[^=]*=[\\$]'/ s/\\\\\\\\M-'/\\\\\\\\xa7/g\" || true)\\012  if [[ -n \"${__CURSOR_SANDBOX_OWNED_ENV:-}\" ]]; then\\012    env_vars=$(builtin printf '%s\\012' \"$env_vars\" | command grep -vE \"^(export|declare|typeset)( -[a-zA-Z]+)* (${__CURSOR_SANDBOX_OWNED_ENV// /|})=\" || true)\\012  fi\\012  _emit_encoded \"$env_vars\" \"ENV_VARS_B64\"\\012  _log_timing \"env_variables\"\\012\\012  # Options (replayable as setopt lines). Exclude the errreturn/nounset/pipefail this\\012  # function force-enables above, so they are not baked into the restored snapshot and\\012  # leaked onto every subsequent command (a stray pipefail makes a successful\\012  # 'cmd | head' report exit 141).\\012  local zsh_opts\\012  zsh_opts=$(setopt 2>/dev/null | command grep -vE '^(errreturn|nounset|pipefail)$' | command awk '{printf \"builtin setopt %s 2>/dev/null || true\\n\", $0}' || true)\\012  _emit_encoded \"$zsh_opts\" \"ZSH_OPTS_B64\"\\012  _log_timing \"options\"\\012\\012  # Each function ends in a NUL and gets its own eval, since one eval of all is quadratic in size\\012  # and one bad definition would drop the rest. typeset +f lists names without zsh/parameter.\\012  local all_functions fn\\012  all_functions=$(\\012    for fn in ${(f)\"$(builtin typeset +f)\"}; do\\012      builtin typeset -f -- \"$fn\"\\012      builtin print -rn -- $'\\0'\\012    done 2>/dev/null || true\\012  )\\012  local replay_functions='for cursor_snap_fn in \"${(@0)cursor_snap_FUNCTIONS_B64}\"; do builtin eval \"$cursor_snap_fn\" || builtin true; done'\\012  _emit_encoded \"$all_functions\" \"FUNCTIONS_B64\" \"$replay_functions\"\\012  _log_timing \"functions\"\\012\\012  # Aliases (regular, global, and suffix)\\012  local alias_lines\\012  alias_lines=$({\\012    builtin alias -L 2>/dev/null || true\\012    builtin alias -gL 2>/dev/null || true\\012    builtin alias -sL 2>/dev/null || true\\012  })\\012  _builtin_alias_lines \"$alias_lines\" || true\\012  _log_timing \"aliases\"\\012\\012  # Done\\012  _emit \"# end of zsh state dump\"\\012  _emit \"__CURSOR_ZSH_STATE_END__\"\\012  _log_timing \"finalize\"\\012}\\012 builtin eval \"$snap\"; { builtin unsetopt nounset 2>/dev/null || true; builtin eval \"${__CURSOR_SANDBOX_ENV_RESTORE:-}\" 2>/dev/null; builtin eval \"${__CURSOR_SANDBOX_TEMP_RESTORE:-}\" 2>/dev/null; builtin export NODE_DISABLE_COMPILE_CACHE=1; builtin unset NODE_COMPILE_CACHE; builtin export PWD=\"$(builtin pwd)\"; builtin setopt aliases 2>/dev/null; builtin eval \"$1\" < /dev/null; }; COMMAND_EXIT_CODE=$?; dump_zsh_state >&4; builtin exit $COMMAND_EXIT_CODE --\n79765 79557 79765 /home/user/.local/bin/cursor-agent --disable-sigusr1 --use-system-ca /home/user/.local/share/cursor-agent/versions/2026.11.22-e9042b2/index.js --trust --approve-mcps --add-dir /scratch/kit --sandbox disabled acp\n79557 79547 79545 /home/user/fridae studios/.claude/worktrees/agent-aab2111d4b425c8ef/app-rs/target/debug/fridae\n79547 79545 79545 /opt/homebrew/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework/Versions/3.14/Resources/Python.app/Contents/MacOS/Python /scratch/probe/app_run.py app\nSHELL=/bin/zsh ZDOTDIR= args=app\n","stderr":""}}}}
