{
  "name": "cinematic",
  "about": "Trailer pacing: longer shots, slow push-ins, dips to black, letterbox bars, small wide-tracked serif subtitles.",
  "rhythm": {
    "shot": [
      2.0,
      4.0
    ],
    "zoom": "in"
  },
  "transitions": {
    "default": "fade",
    "set": [
      "fade",
      "cut",
      "flash"
    ]
  },
  "captions": "cinema",
  "grade": {
    "saturate": 0.9,
    "contrast": 1.1,
    "brightness": 0.96
  },
  "letterbox": true,
  "title": {
    "family": "Libre Baskerville",
    "file": "LibreBaskerville-wght.ttf",
    "weight": 500,
    "case": "upper",
    "size": 4.6,
    "lineHeight": 1.5,
    "letterSpacing": 0.22,
    "y": 0.45,
    "color": "#EFE9DD",
    "accent": "#FFFFFF",
    "stroke": 0,
    "strokeColor": "#000000",
    "shadow": "0 0 0.5em rgba(0,0,0,0.8)",
    "background": [
      "#000000",
      "#0B0B0D"
    ],
    "anim": "reveal"
  },
  "end": {
    "seconds": 2.0,
    "scrim": "rgba(0,0,0,0.7)",
    "ctaFill": "rgba(0,0,0,0)",
    "ctaColor": "#EFE9DD",
    "ctaOutline": "#EFE9DD"
  }
}
